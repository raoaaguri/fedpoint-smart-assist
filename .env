# true = answers come from public/data/*.json (mock backend). Set to false once the backend is ready.
VITE_USE_MOCK=true

# Real backend base URL (used only when VITE_USE_MOCK=false). Example: https://api.example.com/smart-assist
VITE_API_BASE_URL=

# Request timeout in ms
VITE_API_TIMEOUT=15000

# Fake network delay for mock calls, in ms
VITE_MOCK_DELAY=650
